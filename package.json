{
  "name": "license-issuer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "build": "vite build",
    "dev:web": "vite",
    "typecheck": "tsc -p web --noEmit",
    "check": "for f in server.mjs lib.mjs cards.mjs logs.mjs settings.mjs admin.mjs; do node --check $f || exit 1; done && npm run typecheck",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "admin": "node --env-file-if-exists=.env admin.mjs",
    "admin:init": "node --env-file-if-exists=.env admin.mjs init-default",
    "admin:init-custom": "node --env-file-if-exists=.env admin.mjs init",
    "admin:reset-password": "node --env-file-if-exists=.env admin.mjs reset-password",
    "admin:rename": "node --env-file-if-exists=.env admin.mjs rename",
    "admin:import-env": "node --env-file-if-exists=.env admin.mjs import-env",
    "password-hash": "node admin.mjs password-hash",
    "check-key": "node --env-file-if-exists=.env admin.mjs check-key"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
