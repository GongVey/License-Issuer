{
  "name": "license-issuer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "build": "for f in server.mjs lib.mjs cards.mjs logs.mjs settings.mjs admin.mjs public/app.js public/theme.js public/js/*.js public/js/views/*.js; do node --check $f || exit 1; done",
    "test": "node --test test/*.test.mjs",
    "admin": "node --env-file-if-exists=.env admin.mjs",
    "admin:init": "node --env-file-if-exists=.env admin.mjs init-default",
    "admin:init-custom": "node --env-file-if-exists=.env admin.mjs init",
    "admin:reset-password": "node --env-file-if-exists=.env admin.mjs reset-password",
    "admin:rename": "node --env-file-if-exists=.env admin.mjs rename",
    "admin:import-env": "node --env-file-if-exists=.env admin.mjs import-env",
    "password-hash": "node admin.mjs password-hash",
    "check-key": "node --env-file-if-exists=.env admin.mjs check-key"
  }
}
