# Node 24.15+ (24.x). No credentials or private keys belong in this file.
HOST=127.0.0.1
PORT=8787
# For deployment use the exact HTTPS origin, without a trailing slash.
PUBLIC_ORIGIN=http://127.0.0.1:8787
DATABASE_PATH=./data/issuer.sqlite
# First run: npm run admin:init (interactive username + hidden password confirmation).
# Initialization needs only DATABASE_PATH; no signing key is needed until server start.
# Credentials live in SQLite: username and salted scrypt hash, never plaintext passwords.
# Account maintenance: sign in and use Account Security (current password required).
# Local recovery: npm run admin:reset-password / npm run admin:rename.
# For a random temporary admin password: npm run admin -- init-default (empty DB only).
# Both revoke administrator sessions. Restrict OS access to CLI, DB and backups.
# Existing ENV deployment: keep its explicit ADMIN_USERNAME and ADMIN_PASSWORD_HASH
# temporarily, run npm run admin:import-env ONCE, then remove those two variables.
# Import refuses a nonempty administrator table. Startup never imports or overwrites it.
# Legacy sessions are revoked on schema migration; issued licenses are preserved.
# Help: npm run admin -- --help
# Required: absolute path OUTSIDE the repository to an existing Ed25519 PKCS8 PEM.
LICENSE_PRIVATE_KEY_PATH=
# Optional for encrypted PEM; inject through your secret manager.
LICENSE_PRIVATE_KEY_PASSPHRASE=
# Public, not a secret. Must equal the effective public key of target clients.
LICENSE_EXPECTED_PUBLIC_KEY=7K3Lua0o-z03ZKplamnmLAwKrG8QmQble1pkwgypUe4
# Client accepts any nonempty edition. This server's explicit issuance policy:
LICENSE_EDITIONS=standard
